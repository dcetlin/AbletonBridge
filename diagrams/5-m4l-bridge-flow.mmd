graph LR
    subgraph "MCP Tool Layer"
        TOOL["@mcp.tool() function"]
    end

    subgraph "Authoring Protocol — TCP 9877"
        direction TB
        TCP_SEND["AbletonConnection<br/>send_command()"]
        TCP_WIRE["JSON newline-delimited"]
        TCP_RECV["Remote Script<br/>_process_command()"]
        REG["_registry.py<br/>dispatch() · 255 commands"]
        HAND["Handler functions<br/>@command decorated"]
        LOM1["LOM — standard API<br/>tracks · clips · devices · mixer"]

        TCP_SEND --> TCP_WIRE --> TCP_RECV --> REG --> HAND --> LOM1
    end

    subgraph "Deep Access Protocol — UDP 9878/9879"
        direction TB
        M4L_SEND["M4LConnection<br/>send_command()"]
        M4L_WIRE["OSC + base64 JSON"]
        M4L_RECV["Devicev2.amxd<br/>JS OSC parser"]
        M4L_DISP["elif dispatch<br/>30 commands"]
        LOM2["LOM — deep access<br/>hidden params · audio · chains"]

        M4L_SEND --> M4L_WIRE --> M4L_RECV --> M4L_DISP --> LOM2
    end

    TOOL -->|"structural control<br/>(tracks, clips, automation)"| TCP_SEND
    TOOL -->|"deep introspection<br/>(hidden params, audio analysis)"| M4L_SEND

    style REG fill:#4a9,stroke:#333,color:#fff
    style M4L_DISP fill:#c96,stroke:#333,color:#fff
